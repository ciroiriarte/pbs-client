<project name="home:ciriarte:pbs-client">
  <title>Proxmox Backup client suite (from source, unofficial)</title>
  <description>Community/unofficial builds of the Proxmox Backup CLIENT suite
(proxmox-backup-client, pxar, proxmox-file-restore) from upstream Rust sources
(AGPL-3). Not endorsed by Proxmox Server Solutions GmbH. Source/automation:
https://github.com/ciroiriarte/pbs-client</description>
  <person userid="ciriarte" role="maintainer"/>

  <!-- ============================ openSUSE ============================ -->
  <repository name="openSUSE_Tumbleweed">
    <path project="openSUSE:Factory" repository="snapshot"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="openSUSE_Slowroll">
    <path project="openSUSE:Slowroll" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- Leap base rust lags MSRV (1.81); pull current toolchain from devel:languages:rust. -->
  <repository name="openSUSE_Leap_16.0">
    <path project="openSUSE:Leap:16.0" repository="standard"/>
    <path project="devel:languages:rust" repository="openSUSE_Leap_16.0"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="openSUSE_Leap_15.6">
    <path project="openSUSE:Leap:15.6" repository="standard"/>
    <path project="devel:languages:rust" repository="openSUSE_Leap_15.6"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ======================= RHEL-compatible ========================= -->
  <!-- EL9 rust-toolset must be >= 1.81; RHEL9 in 2026 satisfies this. If a
       future MSRV bump outruns EL9, add EPEL9 to this path (see tools/bump.py). -->
  <repository name="RockyLinux_9">
    <path project="Rocky:9" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="RockyLinux_10">
    <path project="Rocky:10" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ============================= Ubuntu ============================ -->
  <repository name="xUbuntu_24.04">
    <path project="Ubuntu:24.04" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="xUbuntu_26.04">
    <path project="Ubuntu:26.04" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
</project>
