<project name="home:ciriarte:pbs-client">
  <title>Proxmox Backup client suite (from source, unofficial)</title>
  <description>Community/unofficial builds of the Proxmox Backup CLIENT suite
(proxmox-backup-client, pxar, proxmox-file-restore) from upstream Rust sources
(AGPL-3). Not endorsed by Proxmox Server Solutions GmbH. Source/automation:
https://github.com/ciroiriarte/pbs-client</description>
  <person userid="ciriarte" role="maintainer"/>

  <!-- The build carries its own offline Rust toolchain (in the Source0 bundle),
       so it needs only base gcc/clang/fuse3/etc. from each distro — no distro
       rust, no versioned-toolchain or backports gymnastics. Repositories below
       therefore just point at each distro's base + the -devel repo where needed.
       aarch64 is enabled only where OBS mirrors that distro's aarch64 base. -->

  <!-- ============================ openSUSE ============================ -->
  <repository name="openSUSE_Tumbleweed">
    <path project="openSUSE:Factory" repository="snapshot"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- openSUSE:Slowroll publishes x86_64 only on OBS. -->
  <repository name="openSUSE_Slowroll">
    <path project="openSUSE:Slowroll" repository="standard"/>
    <arch>x86_64</arch>
  </repository>

  <repository name="openSUSE_Leap_16.0">
    <path project="openSUSE:Leap:16.0" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- Leap 15.6 now builds: base rust (1.77) no longer matters — the bundled
       toolchain is used. Needs only base gcc/clang/fuse3-devel. -->
  <repository name="openSUSE_Leap_15.6">
    <path project="openSUSE:Leap:15.6" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ======================= RHEL-compatible ========================= -->
  <!-- Base system from baseos+appstream; -devel build deps (fuse3-devel, etc.)
       from CRB. x86_64 only — OBS does not mirror the RockyLinux aarch64 base.
       (Oracle/Alma 9/10 users can consume these EL RPMs directly.) -->
  <repository name="RockyLinux_9">
    <path project="RockyLinux:9" repository="baseos"/>
    <path project="RockyLinux:9" repository="appstream"/>
    <path project="RockyLinux:9" repository="CRB"/>
    <arch>x86_64</arch>
  </repository>

  <repository name="RockyLinux_10">
    <path project="RockyLinux:10" repository="baseos"/>
    <path project="RockyLinux:10" repository="appstream"/>
    <path project="RockyLinux:10" repository="CRB"/>
    <arch>x86_64</arch>
  </repository>

  <!-- ============================= Ubuntu ============================ -->
  <!-- OBS Ubuntu repositories are named "universe". No pocket gymnastics needed
       now (the old versioned-rustc hack is gone with the bundled toolchain). -->
  <repository name="Ubuntu_24.04">
    <path project="Ubuntu:24.04" repository="universe"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="Ubuntu_26.04">
    <path project="Ubuntu:26.04" repository="universe"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ============================= Debian ============================ -->
  <!-- aarch64 ONLY, by design: Proxmox's official Debian client repo covers
       x86_64, so we only fill the arm64 gap. Bundled rust removes the MSRV wall,
       so Bullseye/Bookworm/Trixie all build now. -->
  <repository name="Debian_13">
    <path project="Debian:13" repository="standard"/>
    <arch>aarch64</arch>
  </repository>

  <repository name="Debian_12">
    <path project="Debian:12" repository="standard"/>
    <arch>aarch64</arch>
  </repository>

  <repository name="Debian_11">
    <path project="Debian:11" repository="standard"/>
    <arch>aarch64</arch>
  </repository>
</project>
