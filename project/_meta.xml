<project name="home:ciriarte:pbs-client">
  <title>Proxmox Backup client suite (from source, unofficial)</title>
  <description>Community/unofficial builds of the Proxmox Backup CLIENT suite
(proxmox-backup-client, pxar, proxmox-file-restore) from upstream Rust sources
(AGPL-3). Not endorsed by Proxmox Server Solutions GmbH. Source/automation:
https://github.com/ciroiriarte/pbs-client</description>
  <person userid="ciriarte" role="maintainer"/>

  <!-- ============================ openSUSE ============================ -->
  <!-- Tumbleweed builds against openSUSE:Factory/snapshot. -->
  <repository name="openSUSE_Tumbleweed">
    <path project="openSUSE:Factory" repository="snapshot"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- openSUSE:Slowroll publishes x86_64 only. -->
  <repository name="openSUSE_Slowroll">
    <path project="openSUSE:Slowroll" repository="standard"/>
    <arch>x86_64</arch>
  </repository>

  <!-- Leap uses its own (versioned) rust; devel:languages:rust does not build
       for Leap. If Leap 15.6 rust proves < 1.81 (MSRV), revisit this path. -->
  <repository name="openSUSE_Leap_16.0">
    <path project="openSUSE:Leap:16.0" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- Leap 15.6 DROPPED: real MSRV is 1.87; base rust is 1.77. rust1.97 from
       devel:languages:rust needs gcc15, whose libgcc_s1>=15.3 requirement OBS
       won't satisfy from devel:gcc's flavored runtime — an unresolvable cascade. -->
  <repository name="openSUSE_Leap_15.6">
    <path project="openSUSE:Leap:15.6" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ======================= RHEL-compatible ========================= -->
  <!-- OBS hosts RockyLinux:9 / RockyLinux:10 (not "Rocky:9"). CRB carries the
       -devel build deps (fuse3-devel, systemd-devel, etc.). EL rust-toolset
       must be >= 1.81; verify on first build, add EPEL if short. -->
  <!-- Base system comes from baseos+appstream; -devel build deps from CRB.
       ("standard" alone does not provide rpm/the build root.) -->
  <repository name="RockyLinux_9">
    <path project="RockyLinux:9" repository="baseos"/>
    <path project="RockyLinux:9" repository="appstream"/>
    <path project="RockyLinux:9" repository="CRB"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="RockyLinux_10">
    <path project="RockyLinux:10" repository="baseos"/>
    <path project="RockyLinux:10" repository="appstream"/>
    <path project="RockyLinux:10" repository="CRB"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ============================= Ubuntu ============================ -->
  <!-- OBS Ubuntu repositories are named "universe", not "standard". -->
  <!-- Ubuntu 24.04 default rustc is 1.74 (< MSRV 1.87), but universe-update ships
       versioned rustc-1.89/1.91 + cargo-1.89/1.91 toolchain packages; the build
       pulls them via build-dep alternatives and debian.rules picks the newest. -->
  <repository name="Ubuntu_24.04">
    <path project="Ubuntu:24.04" repository="universe-update"/>
    <path project="Ubuntu:24.04" repository="universe"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <repository name="Ubuntu_26.04">
    <path project="Ubuntu:26.04" repository="universe"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>

  <!-- ============================= Debian ============================ -->
  <!-- aarch64 ONLY, by design: Proxmox's official Debian client repo covers
       x86_64, so we fill only the arm64 gap. Trixie's stable rustc is 1.85
       (< MSRV 1.87), but trixie-backports ships rustc 1.94 — the backports path
       first + Build-Depends rustc(>=1.87) forces the resolver to pick it.
       Bullseye stays out (max rust 1.63, no backport helps). -->
  <repository name="Debian_13">
    <path project="Debian:13" repository="backports"/>
    <path project="Debian:13" repository="standard"/>
    <arch>aarch64</arch>
  </repository>
</project>
