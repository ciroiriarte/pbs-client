<services>
  <!--
    Fetch the upstream Proxmox Backup sources at a specific release tag from the
    CANONICAL git (git.proxmox.com). The GitHub mirror (github.com/proxmox/
    proxmox-backup) lags by a major version, so we do NOT use it here.

    Runs server-side at `osc` commit time (network available); build workers are
    network-isolated and consume only the committed tarballs.

    NOTE: upstream ships NO Cargo.lock (they build via Debian dh-cargo against
    librust-* packages). Therefore cargo_vendor runs with update="true" so it
    resolves the dependency graph and generates a lockfile itself. The resulting
    committed vendor.tar.zst IS our pin: reproducible until the next version bump
    re-resolves. `tools/bump.py` re-runs this service per new tag.
  -->
  <service name="obs_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://git.proxmox.com/git/proxmox-backup.git</param>
    <param name="revision">v4.2.0</param>            <!-- bumped by tools/bump.py -->
    <param name="filename">proxmox-backup</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="changesgenerate">disable</param>
  </service>

  <!-- Recompress the obs_scm cpio archive into a plain tarball cargo_vendor can read. -->
  <service name="recompress" mode="manual">
    <param name="file">proxmox-backup-*.tar</param>
    <param name="compression">zst</param>
  </service>

  <service name="set_version" mode="manual"/>

  <!--
    obs-service-cargo (openSUSE-Rust). Produces vendor.tar.zst + cargo_config.
    update=true   : generate a lockfile (upstream has none) then vendor.
    versioned-dirs: keep multiple versions of a crate side by side if needed.
    If a future tag DOES ship a Cargo.lock, flip update="false"
    respect-lockfile="true" to freeze exactly to it.
  -->
  <service name="cargo_vendor" mode="manual">
    <param name="srctar">proxmox-backup-*.tar.zst</param>
    <param name="compression">zst</param>
    <param name="update">true</param>
    <param name="versioned-dirs">true</param>
  </service>
</services>
