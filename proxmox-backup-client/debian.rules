#!/usr/bin/make -f
# Community/unofficial Proxmox Backup client build for Debian/Ubuntu targets on OBS.
# Source0 is the self-contained bundle (see the .spec header): the proxmox-backup
# workspace, its path-patched sibling crates, a vendor/ dir, and an offline Rust
# toolchain (rust-<ver>-<triple>.tar.xz at the top). Builds fully offline.

export CARGO_HOME = $(CURDIR)/cargo-home
export ZSTD_SYS_USE_PKG_CONFIG = 1
export OPENSSL_NO_VENDOR = 1

# Bundled offline Rust toolchain — the build does not use the distro's rust.
RUST_VERSION := 1.90.0
DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH 2>/dev/null)
RUST_TRIPLE := $(if $(filter arm64,$(DEB_HOST_ARCH)),aarch64,x86_64)-unknown-linux-gnu
RUSTTC := $(CURDIR)/rusttc

# pbs-buildcfg/build.rs embeds REPOID; without it it shells out to `git` (absent
# in the build root, and the bundle carries no .git). Provide the version instead.
export REPOID = $(shell dpkg-parsechangelog -SVersion 2>/dev/null | cut -d- -f1)

%:
	dh $@

override_dh_auto_configure:
	# dpkg-source strips cargo-vendor's *.orig files (they collide with dpkg's
	# .orig/patch convention), breaking cargo's per-file checksum verification.
	# Empty the per-file checksums but KEEP each crate's "package" sha (cargo
	# verifies that against Cargo.lock). Use xargs, not -exec: the sed replacement
	# contains {}, which collides with find's {} placeholder.
	find vendor -name .cargo-checksum.json -print0 | xargs -0 sed -i 's/"files":{[^}]*}/"files":{}/'
	# Install the bundled Rust toolchain for this build arch.
	tar -xf rust-$(RUST_VERSION)-$(RUST_TRIPLE).tar.xz
	rust-$(RUST_VERSION)-$(RUST_TRIPLE)/install.sh --prefix=$(RUSTTC) \
	  --disable-ldconfig --components=rustc,cargo,rust-std-$(RUST_TRIPLE)

override_dh_auto_build:
	cd proxmox-backup && PATH=$(RUSTTC)/bin:$$PATH \
	  LD_LIBRARY_PATH=$(RUSTTC)/lib$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH} \
	  cargo build --release --offline \
	  -p proxmox-backup-client --bin proxmox-backup-client \
	  -p pxar-bin              --bin pxar \
	  -p proxmox-file-restore  --bin proxmox-file-restore

override_dh_auto_test:
	# Skip upstream test suite for a client-only vendored build.

override_dh_auto_install:
	# Handled via debian.*.install files (paths under proxmox-backup/).

override_dh_auto_clean:
	rm -rf proxmox-backup/target cargo-home rusttc rust-$(RUST_VERSION)-*
