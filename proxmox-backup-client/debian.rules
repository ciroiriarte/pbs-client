#!/usr/bin/make -f
# Community/unofficial Proxmox Backup client build for Debian/Ubuntu targets on OBS.
# Source0 is the self-contained bundle (see the .spec header): the proxmox-backup
# workspace plus its path-patched sibling crates and a vendor/ dir. Builds offline.

export CARGO_HOME = $(CURDIR)/cargo-home
export ZSTD_SYS_USE_PKG_CONFIG = 1
export OPENSSL_NO_VENDOR = 1
# pbs-buildcfg/build.rs embeds REPOID; without it it shells out to `git` (absent
# in the build root, and the bundle carries no .git). Provide the version instead.
export REPOID = $(shell dpkg-parsechangelog -SVersion 2>/dev/null | cut -d- -f1)

%:
	dh $@

override_dh_auto_configure:
	# dpkg-source strips cargo-vendor's *.orig files (they collide with dpkg's
	# .orig/patch convention). Drop entries for now-absent files from each
	# vendored .cargo-checksum.json so the offline build doesn't fail verifying
	# them (Cargo.toml.orig is not used for compilation).
	python3 -c "import json,glob,os;[open(f,'w').write(json.dumps({**d,'files':{k:v for k,v in d['files'].items() if os.path.exists(os.path.join(os.path.dirname(f),k))}})) for f in glob.glob('vendor/*/.cargo-checksum.json') for d in [json.load(open(f))]]"

override_dh_auto_build:
	cd proxmox-backup && cargo build --release --offline \
	  -p proxmox-backup-client --bin proxmox-backup-client \
	  -p pxar-bin              --bin pxar \
	  -p proxmox-file-restore  --bin proxmox-file-restore

override_dh_auto_test:
	# Skip upstream test suite for a client-only vendored build.

override_dh_auto_install:
	# Handled via debian.*.install files (paths under proxmox-backup/).

override_dh_auto_clean:
	rm -rf proxmox-backup/target cargo-home
